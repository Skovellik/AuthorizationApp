<Window x:Class="AuthorizationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AuthorizationApp"
        mc:Ignorable="d"
        Title="Авторизация" Height="350" Width="450">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,5"/>
            <Button Content="Вход" Click="btnLogin_Click" Margin="0,10,0,0"/>
            <Button Content="Регистрация" Click="btnRegister_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
